\f0\fs24 \cf0 --1\
SELECT localcompra AS Local_Compra, COUNT(*) AS Quantidade_CD\
	FROM CD\
	GROUP BY localcompra;\
--2\
SELECT localcompra AS Local_Compra, COUNT(*) AS Quantidade_CD\
	FROM CD\
	GROUP BY localcompra\
    ORDER BY Quantidade_CD DESC;\
--3\
SELECT localcompra AS Local_COMPRA, COUNT(DISTINCT ideditora) AS Quantidade_Editoras\
	FROM CD\
	GROUP BY localcompra\
    ORDER BY Quantidade_Editoras ASC;\
--4\
SELECT localcompra AS Local_Compra,\
    COUNT(*) AS Quantidade_CD,\
    SUM(valorpago) AS Total,\
    MAX(valorpago) AS Maior\
	FROM CD\
    WHERE localcompra IS NOT NULL\
	GROUP BY localcompra\
    ORDER BY Quantidade_CD DESC;\
--5\
SELECT codcd AS COD_CD, \
       interprete AS INTERPRETE,\
       COUNT(*) AS QUANTIDADE_MUSICA\
FROM MUSICA\
GROUP BY codcd, interprete\
ORDER BY codcd ASC;\
--6\
SELECT localcompra AS Local_Compra, COUNT(*) AS Quantidade_CD\
	FROM CD\
	GROUP BY localcompra\
    HAVING COUNT(*) > 2;\
--7\
SELECT localcompra AS Local_Compra, \
    COUNT(*) AS Quantidade_CD,\
    SUM(valorpago) AS TOTAL\
	FROM CD\
	GROUP BY localcompra\
    HAVING AVG(valorpago) < 10;\
--8\
SELECT localcompra AS Local_Compra, \
    SUM(valorpago) AS TOTAL\
	FROM CD\
	GROUP BY localcompra\
    HAVING COUNT(*) > 2;\
--9\
SELECT codcd AS COD_CD, \
       interprete AS INTERPRETE\
	FROM MUSICA\
	GROUP BY codcd, interprete\
	HAVING COUNT(*) = 1\
	ORDER BY codcd ASC;\
